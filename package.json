{
  "name": "productivityai-desktop",
  "productName": "ProductivityAI",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop tracking application of the AI-powered productivity dashboard for Windows 10 and 11.",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "dev:tracker": "electron-vite build --mode development && electron ./out/main/dev-tracker.js",
    "mock-api": "node tools/mock-api/server.ts",
    "build": "electron-vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "allowScripts": {
    "better-sqlite3-multiple-ciphers": false,
    "get-windows": false
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.2.0",
    "get-windows": "^10.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-vite": "^6.0.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2009",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}

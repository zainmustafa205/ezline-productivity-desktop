# Public build-time values of the main process. They are compiled into the
# application and can be read by anyone who has the installer: never put a
# secret here. Copy this file to .env.local only when a value must differ from
# the development default.

# Backend API base URL, without a trailing slash.
# Development default: the mock API (http://127.0.0.1:4010). Required (https) in
# the production build. Never point local tests at the production backend.
MAIN_VITE_API_URL=

# Web app origin, without a trailing slash (forgot password, dashboard and
# download links). Development default: http://localhost:5173. Required (https)
# in the production build.
MAIN_VITE_WEB_APP_URL=
